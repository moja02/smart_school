APP_NAME="Smart School"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database (Render PostgreSQL or MySQL)
DB_CONNECTION=pgsql
# or use DATABASE_URL if provided by host

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Real-time Reverb (Optional on free tier)
BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
